# Digital Twin Manufacturing System - Environment Variables
# Copy this file to .env and fill in your MySQL credentials

# MySQL Database Configuration
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_password_here
MYSQL_DATABASE=digital_twin_mfg

# Full Database URL (used by SQLAlchemy)
DATABASE_URL=mysql+pymysql://root:your_password_here@localhost:3306/digital_twin_mfg

# Application Settings
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=True

# Simulation Defaults
DEFAULT_SPEED_MULTIPLIER=5.0
DEFAULT_ARRIVAL_RATE=8.0
